#!/bin/sh
# Project-local REA; no global client registration or shell-profile changes.
set -eu
rea_project_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
rea_entry="$rea_project_root/.tools/rea/node_modules/rea-agents/scripts/rea.mjs"
if [ ! -f "$rea_entry" ]; then
  printf '%s\n' 'Project-local REA is missing. See README.md for the pinned installation.' >&2
  exit 1
fi
if [ -z "${GHIDRA_INSTALL_DIR:-}" ] && [ -d "$rea_project_root/.tools/ghidra" ]; then
  export GHIDRA_INSTALL_DIR="$rea_project_root/.tools/ghidra"
fi
if [ -z "${JAVA_HOME:-}" ] && [ -d /Library/Java/JavaVirtualMachines/jdk-21.jdk/Contents/Home ]; then
  export JAVA_HOME=/Library/Java/JavaVirtualMachines/jdk-21.jdk/Contents/Home
fi
exec node "$rea_entry" "$@"
