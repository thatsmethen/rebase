<Application x:Class="Rebase.Windows.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#343A40" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#E5E8ED" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#526676" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#343A40" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#E5E8ED" />
    <SolidColorBrush x:Key="PanelBrush" Color="#303437" />
    <SolidColorBrush x:Key="TextBrush" Color="#E5E8ED" />
    <SolidColorBrush x:Key="MutedBrush" Color="#8D96A4" />
    <SolidColorBrush x:Key="AccentBrush" Color="#5BC8DB" />
    <SolidColorBrush x:Key="HairlineBrush" Color="#2B3038" />
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextBrush}" /></Style>
    <Style x:Key="SectionLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedBrush}" /><Setter Property="FontSize" Value="10" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Margin" Value="0,0,0,9" /></Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" /><Setter Property="Background" Value="#41464B" /><Setter Property="BorderBrush" Value="#181D21" /><Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="7,3" /><Setter Property="Margin" Value="2" /><Setter Property="MinHeight" Value="24" /><Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="1" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Background" Value="#343B47" /><Setter TargetName="Body" Property="BorderBrush" Value="#667481" /></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Body" Property="Background" Value="#1B4650" /></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <!-- Coloured events/name plates and the light Stop button retain their
         actual fill and content contrast in every interaction state. -->
    <Style x:Key="AccentSurfaceButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid>
        <Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="1" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" /></Border>
        <Border x:Name="Feedback" Background="White" Opacity="0" IsHitTestVisible="False" CornerRadius="1" />
      </Grid><ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="#F0F2F4" /><Setter TargetName="Feedback" Property="Opacity" Value="0.08" /></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="#171A1D" /><Setter TargetName="Feedback" Property="Opacity" Value="0.16" /></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38" /></Trigger>
      </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /></Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" /><Setter Property="Background" Value="#24292D" /><Setter Property="BorderBrush" Value="#343B46" /><Setter Property="BorderThickness" Value="1" />
      <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" /><Setter Property="SelectionBrush" Value="#356574" /><Setter Property="Padding" Value="5,3" /><Setter Property="Margin" Value="2" /><Setter Property="MinHeight" Value="24" /><Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="1"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" /></Border>
        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{StaticResource TextBrush}" /><Setter Property="Background" Value="#20262E" /><Setter Property="Padding" Value="10,7" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Body" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Body" Property="Background" Value="#344653" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" /><Setter Property="Background" Value="#20262E" /><Setter Property="BorderBrush" Value="#343B46" /><Setter Property="Margin" Value="3" /><Setter Property="Padding" Value="5,3" /><Setter Property="MinHeight" Value="30" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
        <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press">
          <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Body" Background="#20262E" BorderBrush="#343B46" BorderThickness="1" CornerRadius="1"><TextBlock Text="⌄" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,3" Foreground="{StaticResource AccentBrush}" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="#667481" /></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
        </ToggleButton>
        <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="9,5,27,5" VerticalAlignment="Center" />
        <Border x:Name="FocusRing" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="1" IsHitTestVisible="False" Visibility="Collapsed" />
        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="#20262E" BorderBrush="#465361" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="260"><ItemsPresenter /></ScrollViewer></Border></Popup>
      </Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Label"><Setter Property="Foreground" Value="{StaticResource MutedBrush}" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Padding" Value="3" /></Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" /><Setter Property="Padding" Value="5,3" /><Setter Property="Margin" Value="3" /><Setter Property="MinWidth" Value="32" /><Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Border x:Name="Body" Background="#252A32" BorderBrush="#343B46" BorderThickness="1" CornerRadius="1" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Body" Property="Background" Value="#244B57" /><Setter Property="Foreground" Value="#79D9E8" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="#667481" /></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SliderPage" TargetType="RepeatButton"><Setter Property="Focusable" Value="False" /><Setter Property="Background" Value="Transparent" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="{TemplateBinding Background}" /></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="Slider">
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" /><Setter Property="Margin" Value="3" /><Setter Property="IsMoveToPointEnabled" Value="True" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid x:Name="Body" Background="Transparent" MinWidth="18" MinHeight="18">
        <Border x:Name="Rail" Height="3" VerticalAlignment="Center" Background="#303640" CornerRadius="1" />
        <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}">
          <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderPage}" /></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb x:Name="Knob" Width="12" Height="12" Background="#CFD8DF"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="Grip" Background="{TemplateBinding Background}" BorderBrush="#8898A6" BorderThickness="1" CornerRadius="3"><Border Height="1" Background="#6A7683" Margin="3,0" VerticalAlignment="Center" /></Border></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderPage}" /></Track.IncreaseRepeatButton>
        </Track>
      </Grid><ControlTemplate.Triggers><Trigger Property="Orientation" Value="Vertical"><Setter TargetName="Rail" Property="Height" Value="Auto" /><Setter TargetName="Rail" Property="Width" Value="3" /><Setter TargetName="Rail" Property="VerticalAlignment" Value="Stretch" /><Setter TargetName="Rail" Property="HorizontalAlignment" Value="Center" /><Setter TargetName="Knob" Property="Width" Value="28" /><Setter TargetName="Knob" Property="Height" Value="13" /></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Knob" Property="Background" Value="{StaticResource AccentBrush}" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar"><Setter Property="Background" Value="#11151A" /><Setter Property="Width" Value="9" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="{TemplateBinding Background}"><Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton x:Name="Less" Command="ScrollBar.PageUpCommand" Style="{StaticResource SliderPage}" /></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#46505C" Margin="2" CornerRadius="3" /></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton x:Name="More" Command="ScrollBar.PageDownCommand" Style="{StaticResource SliderPage}" /></Track.IncreaseRepeatButton></Track></Grid><ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto" /><Setter Property="Height" Value="9" /><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" /><Setter TargetName="Less" Property="Command" Value="ScrollBar.PageLeftCommand" /><Setter TargetName="More" Property="Command" Value="ScrollBar.PageRightCommand" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ProgressBar"><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /><Setter Property="Background" Value="#2B313A" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Grid x:Name="PART_Track" Background="{TemplateBinding Background}"><Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" /></Grid></ControlTemplate></Setter.Value></Setter></Style>
  </Application.Resources>
</Application>
