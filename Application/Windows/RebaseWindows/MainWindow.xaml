<Window x:Class="Rebase.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Rebase.Windows"
        Title="{Binding Title}" Icon="/Assets/Rebase.png" Width="1320" Height="860" MinWidth="1020" MinHeight="700"
        Closing="ClosingWindow" PreviewKeyDown="KeyPressed">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="#232A34" Padding="12,8">
      <TextBlock Text="{Binding Status}" Foreground="#EDF1F5" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
    </Border>
    <StackPanel x:Name="CommandSurface" DockPanel.Dock="Top" Background="#20252E">
      <WrapPanel Margin="8,6">
        <TextBlock Text="REBASE" Foreground="#EDF1F5" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,22,0" />
        <Button x:Name="ExampleButton" Content="Open example" Click="OpenExample" />
        <Button Content="Open project…" Click="OpenProject" />
        <Button Content="Save" Click="SaveProject" />
        <Button Content="Save As…" Click="SaveProjectAs" />
        <Button Content="Export WAV…" Click="ExportWav" />
        <Button x:Name="UndoButton" Content="Undo" Click="Undo" IsEnabled="False" />
        <Button x:Name="RedoButton" Content="Redo" Click="Redo" IsEnabled="False" />
      </WrapPanel>
      <WrapPanel Margin="8,0,8,8">
        <Button Content="▶ Play" Click="Play" /><Button Content="Ⅱ Pause" Click="Pause" /><Button Content="■ Stop" Click="Stop" />
        <Label Content="Position (s)" /><TextBox x:Name="PositionBox" Width="86" Text="0" AutomationProperties.Name="Playhead seconds" />
        <Button Content="Seek" Click="Seek" />
        <Label Content="Tempo" /><TextBox x:Name="TempoBox" Text="120" Width="64" AutomationProperties.Name="Tempo BPM" />
        <Button Content="Set BPM" Click="SetTempo" />
        <Label Content="Snap" /><ComboBox x:Name="SnapBox" Width="100" SelectedIndex="0" SelectionChanged="SnapChanged" AutomationProperties.Name="Snap grid">
          <ComboBoxItem Content="Off" Tag="off" /><ComboBoxItem Content="Quarter" Tag="quarter" /><ComboBoxItem Content="Eighth" Tag="eighth" /><ComboBoxItem Content="Sixteenth" Tag="sixteenth" /><ComboBoxItem Content="Bar" Tag="bar" />
        </ComboBox>
        <Label Content="Zoom" /><Slider x:Name="Zoom" Width="115" Minimum="15" Maximum="140" Value="40" ValueChanged="ZoomChanged" VerticalAlignment="Center" AutomationProperties.Name="Timeline zoom" />
      </WrapPanel>
    </StackPanel>
    <Border x:Name="EditSurface" DockPanel.Dock="Bottom" Background="#1C222B" Padding="12,10">
      <StackPanel>
        <WrapPanel>
          <Label Content="Selected clip" /><TextBlock x:Name="SelectionName" Text="None" Foreground="#EDF1F5" VerticalAlignment="Center" MinWidth="160" Margin="8,0" />
          <Label Content="Move to (s)" /><TextBox x:Name="MoveBox" Width="75" Text="0" AutomationProperties.Name="Selected clip start seconds" /><Button x:Name="MoveButton" Content="Move" Click="MoveClip" />
          <Label Content="End (s)" /><TextBox x:Name="TrimBox" Width="75" Text="0" AutomationProperties.Name="Selected clip end seconds" /><Button Content="Trim" Click="TrimClip" />
          <Button Content="Split at playhead" Click="SplitClip" /><Button Content="Delete clip" Click="DeleteClip" />
        </WrapPanel>
        <WrapPanel Margin="0,8,0,0">
          <Label Content="Submitted peaks" /><TextBlock Text="L" Foreground="#EDF1F5" VerticalAlignment="Center" Margin="8,0" />
          <ProgressBar Width="150" Height="12" Minimum="0" Maximum="1" Value="{Binding PeakLeft, Mode=OneWay}" AutomationProperties.Name="Left submitted peak" />
          <TextBlock Text="R" Foreground="#EDF1F5" VerticalAlignment="Center" Margin="12,0,8,0" />
          <ProgressBar Width="150" Height="12" Minimum="0" Maximum="1" Value="{Binding PeakRight, Mode=OneWay}" AutomationProperties.Name="Right submitted peak" />
          <TextBlock x:Name="ProjectInfo" Text="No project loaded" Foreground="#A5B1C2" VerticalAlignment="Center" Margin="22,0" />
        </WrapPanel>
      </StackPanel>
    </Border>
    <Grid Margin="10">
      <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="8" /><RowDefinition Height="190" /></Grid.RowDefinitions>
      <ScrollViewer x:Name="TimelineScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><local:TimelineView x:Name="Timeline" /></ScrollViewer>
      <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="#3B4453" />
      <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel x:Name="Mixer" Orientation="Horizontal" />
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
