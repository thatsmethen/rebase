<Window x:Class="Rebase.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Rebase.Windows"
        Title="{Binding Title}" Icon="/Assets/Rebase.png" Width="1280" Height="850" MinWidth="1100" MinHeight="760"
        Background="#282A2C" Foreground="#E5E8ED" FontFamily="Segoe UI" FontSize="11"
        Closing="ClosingWindow" PreviewKeyDown="KeyPressed">
  <Window.Resources>
    <Style x:Key="InspectorSection" TargetType="Expander">
      <Setter Property="Margin" Value="5,1" /><Setter Property="Foreground" Value="#D8DCDF" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><StackPanel>
        <ToggleButton x:Name="HeaderSite" Content="{TemplateBinding Header}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}">
          <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="SectionHeader" Background="#3C4044" BorderBrush="Transparent" BorderThickness="1" Padding="5,4"><DockPanel>
            <Path x:Name="Chevron" Data="M0,0 L4,4 0,8" Stroke="#B8C0C6" StrokeThickness="1" Width="8" Height="8" Margin="0,0,5,0" VerticalAlignment="Center" /><ContentPresenter VerticalAlignment="Center" />
          </DockPanel></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="Data" Value="M0,0 L4,4 8,0" /></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SectionHeader" Property="BorderBrush" Value="#5BC8DB" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SectionHeader" Property="Background" Value="#484D51" /></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
        </ToggleButton>
        <ContentPresenter x:Name="SectionContent" Visibility="Collapsed" ContentSource="Content" />
      </StackPanel><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="SectionContent" Property="Visibility" Value="Visible" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid Background="#282A2C">
    <Grid.RowDefinitions><RowDefinition Height="25" /><RowDefinition Height="30" /><RowDefinition Height="18" /><RowDefinition Height="34" /><RowDefinition Height="*" /><RowDefinition Height="37" /><RowDefinition Height="21" /></Grid.RowDefinitions>
    <DockPanel x:Name="MenuBand" Grid.Row="0" Background="#232527">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0"><Image Source="/Assets/Rebase.png" Width="14" Height="14" VerticalAlignment="Center" /><TextBlock Text="REBASE" FontWeight="SemiBold" FontSize="10" Margin="6,0,5,0" VerticalAlignment="Center" /></StackPanel>
      <Menu x:Name="MainMenu" Background="Transparent" Foreground="#D2D5D8" VerticalAlignment="Center">
        <MenuItem Header="_File"><MenuItem Header="Open example" Click="OpenExample" /><MenuItem Header="Open project…" Click="OpenProject" /><MenuItem x:Name="ImportCPRMenu" Header="Import CPR…" Click="ImportCPRProject" /><MenuItem x:Name="ImportReportMenu" Header="Import Report…" Click="ShowCPRImportReport" /><Separator /><MenuItem Header="Save" Click="SaveProject" InputGestureText="Ctrl+S" /><MenuItem Header="Save as…" Click="SaveProjectAs" /><MenuItem Header="Export mixdown…" Click="ExportWav" /></MenuItem>
        <MenuItem Header="_Edit"><MenuItem Header="Undo" Click="Undo" InputGestureText="Ctrl+Z" /><MenuItem Header="Redo" Click="Redo" InputGestureText="Ctrl+Y" /><Separator /><MenuItem x:Name="SplitMenuItem" Header="Split selected clip at playhead" Click="SplitClip" /><MenuItem x:Name="DeleteMenuItem" Header="Delete selected clip" Click="DeleteClip" /></MenuItem>
        <MenuItem Header="_Project"><MenuItem x:Name="AutomationMenu" Header="Track automation…" Click="ShowAutomation" IsEnabled="False" /></MenuItem>
        <MenuItem Header="_Transport"><MenuItem Header="Play project" Click="Play" /><MenuItem Header="Pause" Click="Pause" /><MenuItem Header="Stop" Click="Stop" /></MenuItem>
      </Menu>
    </DockPanel>
    <Border x:Name="ToolbarBand" Grid.Row="1" Background="#343638" BorderBrush="#181A1C" BorderThickness="0,0,0,1"><Grid x:Name="ProjectActions" Margin="5,2">
      <Grid.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Width" Value="27" /><Setter Property="Height" Value="25" /><Setter Property="MinHeight" Value="25" /><Setter Property="Margin" Value="1,0" /><Setter Property="Padding" Value="5" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
        <Style x:Key="ToolbarIcon" TargetType="Path"><Setter Property="Width" Value="14" /><Setter Property="Height" Value="14" /><Setter Property="Stretch" Value="Uniform" /><Setter Property="Stroke" Value="#D2D5D8" /><Setter Property="StrokeThickness" Value="1.3" /><Setter Property="StrokeLineJoin" Value="Round" /><Setter Property="StrokeStartLineCap" Value="Round" /><Setter Property="StrokeEndLineCap" Value="Round" /><Setter Property="IsHitTestVisible" Value="False" /></Style>
      </Grid.Resources>
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" Margin="0,0,6,0">
        <Button x:Name="ExampleButton" Style="{StaticResource ToolbarButton}" Click="OpenExample" ToolTip="Open example project" AutomationProperties.Name="Open example"><Path Style="{StaticResource ToolbarIcon}" Data="M2,1 L10,1 14,5 14,15 2,15 Z M10,1 L10,5 14,5 M4,10 L6,10 7,7 9,13 10,10 12,10" /></Button>
        <Button x:Name="OpenProjectButton" Style="{StaticResource ToolbarButton}" Click="OpenProject" ToolTip="Open project…" AutomationProperties.Name="Open project"><Path Style="{StaticResource ToolbarIcon}" Data="M1,5 L1,3 6,3 8,5 15,5 M1,5 L3,14 13,14 15,7 4,7 Z" /></Button>
        <Button x:Name="SaveProjectButton" Style="{StaticResource ToolbarButton}" Click="SaveProject" ToolTip="Save project (Ctrl+S)" AutomationProperties.Name="Save project"><Path Style="{StaticResource ToolbarIcon}" Data="M2,1 L12,1 15,4 15,15 1,15 1,1 Z M5,1 L5,6 11,6 11,1 M4,15 L4,10 12,10 12,15" /></Button>
        <Border Width="1" Background="#1C1E20" Margin="5,2" />
        <Button x:Name="UndoButton" Style="{StaticResource ToolbarButton}" ToolTip="Undo (Ctrl+Z)" AutomationProperties.Name="Undo" Click="Undo" IsEnabled="False"><Path Style="{StaticResource ToolbarIcon}" Data="M6,3 L2,7 6,11 M2,7 L10,7 Q14,7 14,11 L14,14" /></Button>
        <Button x:Name="RedoButton" Style="{StaticResource ToolbarButton}" ToolTip="Redo (Ctrl+Y)" AutomationProperties.Name="Redo" Click="Redo" IsEnabled="False"><Path Style="{StaticResource ToolbarIcon}" Data="M10,3 L14,7 10,11 M14,7 L6,7 Q2,7 2,11 L2,14" /></Button>
      </StackPanel>
      <Border Grid.Column="1" Background="#1C1E20" Margin="0,2" />
      <StackPanel x:Name="ArrangementActions" Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,0">
        <Border Width="25" Height="25" Margin="0,0,5,0" ToolTip="Select an event; drag to move or drag its right edge to trim."><Path Style="{StaticResource ToolbarIcon}" Width="12" Height="14" Fill="#D2D5D8" StrokeThickness="0.8" Data="M2,1 L2,14 6,10 9,16 11,15 8,9 14,9 Z" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
        <Button x:Name="SplitToolbarButton" Style="{StaticResource ToolbarButton}" Click="SplitClip" ToolTip="Split selected event at playhead" AutomationProperties.Name="Split selected event at playhead"><Path Style="{StaticResource ToolbarIcon}" Data="M5,6 L14,1 M5,10 L14,15 M5,6 A2.5,2.5 0 1 1 1,3 A2.5,2.5 0 0 1 5,6 M5,10 A2.5,2.5 0 1 0 1,13 A2.5,2.5 0 0 0 5,10 M6,6 L10,9 M6,10 L10,7" /></Button>
        <Button x:Name="DeleteToolbarButton" Style="{StaticResource ToolbarButton}" Click="DeleteClip" ToolTip="Delete selected event (Delete)" AutomationProperties.Name="Delete selected event"><Path Style="{StaticResource ToolbarIcon}" Data="M2,4 L14,4 M6,1 L10,1 11,4 M4,4 L5,15 11,15 12,4 M7,7 L7,12 M9,7 L9,12" /></Button>
        <Border Width="1" Background="#1C1E20" Margin="5,2" /><Label Content="Snap" FontSize="10" />
        <ComboBox x:Name="SnapBox" Width="90" Height="25" MinHeight="25" Margin="2,0" VerticalAlignment="Center" SelectedIndex="0" SelectionChanged="SnapChanged" AutomationProperties.Name="Snap grid"><ComboBoxItem Content="Off" Tag="off" /><ComboBoxItem Content="Quarter" Tag="quarter" /><ComboBoxItem Content="Eighth" Tag="eighth" /><ComboBoxItem Content="Sixteenth" Tag="sixteenth" /><ComboBoxItem Content="Bar" Tag="bar" /></ComboBox>
        <Label Content="Zoom" FontSize="10" Margin="7,0,0,0" /><Slider x:Name="Zoom" Width="78" Minimum="15" Maximum="140" Value="32" ValueChanged="ZoomChanged" VerticalAlignment="Center" AutomationProperties.Name="Timeline zoom" />
        <Border Width="1" Background="#1C1E20" Margin="5,2" /><ComboBox x:Name="RulerModeBox" Width="100" Height="25" MinHeight="25" Margin="0,0,2,0" VerticalAlignment="Center" SelectedIndex="0" SelectionChanged="RulerModeChanged" AutomationProperties.Name="Ruler display"><ComboBoxItem Content="Bars + Beats" /><ComboBoxItem Content="Seconds" /></ComboBox>
        <ComboBox x:Name="RowDensityBox" Width="88" Height="25" MinHeight="25" Margin="5,0,2,0" VerticalAlignment="Center" SelectedIndex="0" SelectionChanged="RowDensityChanged" ToolTip="Track row density" AutomationProperties.Name="Track row density"><ComboBoxItem Content="Compact" /><ComboBoxItem Content="Normal" /></ComboBox>
      </StackPanel>
      <StackPanel Grid.Column="3" Orientation="Horizontal"><CheckBox x:Name="LeftZoneToggle" Content="Left" IsChecked="True" Height="25" Padding="6,3" Margin="2,0" VerticalAlignment="Center" Checked="WorkspacePaneChanged" Unchecked="WorkspacePaneChanged" ToolTip="Show Channel and Inspector" AutomationProperties.Name="Show left zone" /><CheckBox x:Name="MixerZoneToggle" Content="Mixer" IsChecked="True" Height="25" Padding="6,3" Margin="2,0" VerticalAlignment="Center" Checked="WorkspacePaneChanged" Unchecked="WorkspacePaneChanged" ToolTip="Show lower mixer" AutomationProperties.Name="Show lower mixer" /><Button x:Name="ExportButton" Style="{StaticResource ToolbarButton}" Click="ExportWav" ToolTip="Export mixdown…" AutomationProperties.Name="Export mixdown"><Path Style="{StaticResource ToolbarIcon}" Data="M8,1 L8,11 M4,7 L8,11 12,7 M2,10 L2,15 14,15 14,10" /></Button></StackPanel>
    </Grid></Border>
    <Border x:Name="ProjectStatusBand" Grid.Row="2" Background="#2A2C2E" BorderBrush="#181A1C" BorderThickness="0,0,0,1"><Grid Margin="7,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" MinWidth="120" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBlock Text="Project" Foreground="#90959B" VerticalAlignment="Center" Margin="0,0,7,0" FontSize="9" />
      <TextBlock x:Name="ProjectName" Grid.Column="1" Text="Untitled" Foreground="#D7DADD" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" FontSize="10" />
      <TextBlock x:Name="ProjectLimit" Grid.Column="2" Text="Project playback unavailable" Foreground="#D7B77E" VerticalAlignment="Center" Margin="8,0,12,0" FontSize="9" Visibility="Collapsed" />
      <TextBlock x:Name="ProjectInfo" Grid.Column="3" Foreground="#B1B5BA" VerticalAlignment="Center" FontSize="9" MaxWidth="340" TextTrimming="CharacterEllipsis" />
    </Grid></Border>
    <Border x:Name="EventInfoBand" Grid.Row="3" Background="#222426" BorderBrush="#17191B" BorderThickness="0,0,0,1"><Grid x:Name="ClipInspector" Margin="7,0.5">
      <Grid.Resources>
        <Style x:Key="EventNumber" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="FontFamily" Value="Consolas" /><Setter Property="MinHeight" Value="20" /><Setter Property="Height" Value="20" /><Setter Property="Margin" Value="0" /><Setter Property="Padding" Value="4,0" /><Setter Property="ToolTip" Value="Enter to apply. Escape to restore the current project value." /></Style>
        <Style x:Key="EventCommit" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Width" Value="20" /><Setter Property="MinHeight" Value="20" /><Setter Property="Height" Value="20" /><Setter Property="Margin" Value="1,0,0,0" /><Setter Property="Padding" Value="5" /></Style>
        <Style x:Key="EventLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="#91979E" /><Setter Property="FontSize" Value="8.5" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
      </Grid.Resources>
      <Grid.ColumnDefinitions><ColumnDefinition Width="250" /><ColumnDefinition Width="1" /><ColumnDefinition Width="124" /><ColumnDefinition Width="1" /><ColumnDefinition Width="124" /><ColumnDefinition Width="1" /><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Grid x:Name="EventNameCell" Margin="0,0,7,0"><Grid.RowDefinitions><RowDefinition Height="12" /><RowDefinition Height="20" /></Grid.RowDefinitions><TextBlock x:Name="SelectionKind" Text="Event information" Style="{StaticResource EventLabel}" /><TextBlock x:Name="SelectionName" Grid.Row="1" Text="No event selected" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTipService.ShowOnDisabled="True" /></Grid>
      <Border Grid.Column="1" Background="#393D40" Margin="0,2" />
      <Grid x:Name="EventStartCell" Grid.Column="2" Margin="6,0"><Grid.RowDefinitions><RowDefinition Height="12" /><RowDefinition Height="20" /></Grid.RowDefinitions><TextBlock Text="Start (s)" Style="{StaticResource EventLabel}" /><DockPanel Grid.Row="1"><Button x:Name="MoveButton" Style="{StaticResource EventCommit}" Click="MoveClip" DockPanel.Dock="Right" ToolTip="Apply event start" AutomationProperties.Name="Apply event start"><Path Data="M1,5 L4,8 10,1" Stroke="#CED5DB" StrokeThickness="1.4" Stretch="Uniform" IsHitTestVisible="False" /></Button><TextBox x:Name="MoveBox" Style="{StaticResource EventNumber}" Text="—" AutomationProperties.Name="Selected clip start seconds" PreviewKeyDown="NumericFieldKeyDown" /></DockPanel></Grid>
      <Border Grid.Column="3" Background="#393D40" Margin="0,2" />
      <Grid x:Name="EventEndCell" Grid.Column="4" Margin="6,0"><Grid.RowDefinitions><RowDefinition Height="12" /><RowDefinition Height="20" /></Grid.RowDefinitions><TextBlock Text="End (s)" Style="{StaticResource EventLabel}" /><DockPanel Grid.Row="1"><Button x:Name="TrimButton" Style="{StaticResource EventCommit}" Click="TrimClip" DockPanel.Dock="Right" ToolTip="Apply event end" AutomationProperties.Name="Apply event end"><Path Data="M1,5 L4,8 10,1" Stroke="#CED5DB" StrokeThickness="1.4" Stretch="Uniform" IsHitTestVisible="False" /></Button><TextBox x:Name="TrimBox" Style="{StaticResource EventNumber}" Text="—" AutomationProperties.Name="Selected clip end seconds" PreviewKeyDown="NumericFieldKeyDown" /></DockPanel></Grid>
      <Border Grid.Column="5" Background="#393D40" Margin="0,2" />
      <Grid x:Name="EventOffsetCell" Grid.Column="6" Margin="6,0"><Grid.RowDefinitions><RowDefinition Height="12" /><RowDefinition Height="20" /></Grid.RowDefinitions><TextBlock Text="Source offset (s)" Style="{StaticResource EventLabel}" /><TextBlock x:Name="SourceOffsetText" Grid.Row="1" Text="—" FontFamily="Consolas" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ShowOnDisabled="True" /></Grid>
    </Grid></Border>
    <Grid x:Name="Workspace" Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition x:Name="ChannelColumn" Width="104" /><ColumnDefinition x:Name="InspectorColumn" Width="182" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border x:Name="ChannelSurface" Background="#242729" BorderBrush="#151719" BorderThickness="0,0,2,0"><DockPanel>
        <Border DockPanel.Dock="Top" Background="#202224" Padding="6,5" BorderBrush="#151719" BorderThickness="0,0,0,1"><TextBlock Text="Channel" FontWeight="SemiBold" /></Border>
        <Border x:Name="ChannelTrackPlate" DockPanel.Dock="Top" Background="#454A4E" Margin="4,6,4,3" Padding="4,3"><TextBlock x:Name="ChannelTrack" Text="No selection" Foreground="#141719" TextTrimming="CharacterEllipsis" FontSize="10" FontWeight="SemiBold" /></Border>
        <ContentControl x:Name="SelectedChannel" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Bottom" Margin="3,0,2,3" />
      </DockPanel></Border>
      <Border x:Name="EditSurface" Grid.Column="1" Background="#292C2E" BorderBrush="#17191B" BorderThickness="0,0,2,0"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
        <Border Background="#202224" BorderBrush="#151719" BorderThickness="0,0,0,1" Padding="8,5"><TextBlock Text="Inspector" FontWeight="SemiBold" /></Border>
        <Border x:Name="InspectorTrackPlate" Background="#454A4E" Margin="5,6,5,3" Padding="5,4"><TextBlock x:Name="InspectorTrack" Text="No track selected" Foreground="#141719" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /></Border>
        <TextBlock x:Name="InspectorTrackInfo" Text="Open a project to begin" Foreground="#AAB0B7" Margin="10,5,8,10" TextWrapping="Wrap" FontSize="10" />
        <StackPanel x:Name="InspectorTrackControls" Margin="7,0,7,9" IsEnabled="False">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,5"><CheckBox x:Name="InspectorMute" Content="M" ToolTip="Mute selected track" AutomationProperties.Name="Mute selected track" Checked="InspectorMuteChanged" Unchecked="InspectorMuteChanged" Margin="1" MinWidth="34" /><CheckBox x:Name="InspectorSolo" Content="S" ToolTip="Solo selected track" AutomationProperties.Name="Solo selected track" Checked="InspectorSoloChanged" Unchecked="InspectorSoloChanged" Margin="1" MinWidth="34" /></StackPanel>
          <Grid Margin="2,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Volume" Foreground="#AAB0B7" FontSize="10" /><TextBlock x:Name="InspectorGain" Grid.Column="1" Text="—" FontFamily="Consolas" FontSize="10" /></Grid>
          <local:CommitSlider x:Name="InspectorGainSlider" Style="{StaticResource {x:Type Slider}}" Minimum="-96" Maximum="24" SmallChange="0.5" LargeChange="6" Height="18" Margin="2,0,2,4" AutomationProperties.Name="Selected track volume decibels" ValueChanged="InspectorGainPreview" ValueCommitted="InspectorGainCommitted" />
          <Grid Margin="2,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Pan" Foreground="#AAB0B7" FontSize="10" /><TextBlock x:Name="InspectorPan" Grid.Column="1" Text="—" FontFamily="Consolas" FontSize="10" /></Grid>
          <local:CommitSlider x:Name="InspectorPanSlider" Style="{StaticResource {x:Type Slider}}" Minimum="-1" Maximum="1" SmallChange="0.01" LargeChange="0.1" Height="18" Margin="2,0,2,2" AutomationProperties.Name="Selected track pan" ValueChanged="InspectorPanPreview" ValueCommitted="InspectorPanCommitted" />
          <Button x:Name="AutomationButton" Content="Automation…" Click="ShowAutomation" ToolTip="Edit volume and pan automation for the selected track" AutomationProperties.Name="Track automation" Margin="1,5,1,0" />
        </StackPanel>
        <Expander x:Name="EventEditingSection" Style="{StaticResource InspectorSection}" Header="Event editing" IsExpanded="True" FontSize="10" AutomationProperties.Name="Event editing section"><StackPanel><Button x:Name="SplitInspectorButton" Content="Split at playhead" Click="SplitClip" Margin="3,6,3,2" /><Button x:Name="DeleteInspectorButton" Content="Delete selected clip" Click="DeleteClip" Margin="3,2,3,8" /></StackPanel></Expander>
        <Expander x:Name="SourceSection" Style="{StaticResource InspectorSection}" Header="Retained source events" IsExpanded="True" Visibility="Collapsed" FontSize="10" AutomationProperties.Name="Retained source section"><StackPanel x:Name="SourcePanel" Margin="0,0,0,8"><ComboBox x:Name="SourceEventsBox" SelectionChanged="SourceSelectionChanged" AutomationProperties.Name="Retained source event" Margin="2,7,2,3">
          <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
          <ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}"><Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" /></Style></ComboBox.ItemContainerStyle>
        </ComboBox><TextBlock x:Name="SourceMediaInfo" Foreground="#B4BBC3" TextWrapping="Wrap" FontSize="10" Margin="4,4,4,6" /><Button x:Name="AttachSourceButton" Content="Attach PCM…" Click="AttachSourcePCM" /><Button x:Name="SourceAudioButton" Content="Source audio…" Click="ShowSourceAudio" /><Button x:Name="ExportSourceButton" Content="Export source…" Click="ExportSource" /><TextBlock Text="Inspect source, timeline and complete-track modes. Project mixer, routing and effects are bypassed." Foreground="#949BA3" TextWrapping="Wrap" FontSize="10" Margin="4,7,4,0" /></StackPanel></Expander>
        <TextBlock Text="Space  Play / pause&#x0a;Ctrl+S  Save project" Foreground="#7F8790" FontFamily="Consolas" FontSize="10" Margin="10,18,8,0" />
      </StackPanel></ScrollViewer></Border>
      <Grid x:Name="ArrangementWorkspace" Grid.Column="2" SizeChanged="WorkspaceSizeChanged"><Grid.RowDefinitions><RowDefinition x:Name="ArrangementRow" Height="*" MinHeight="220" /><RowDefinition x:Name="MixerDividerRow" Height="5" /><RowDefinition x:Name="MixerRow" Height="216" MinHeight="196" MaxHeight="376" /></Grid.RowDefinitions>
        <ScrollViewer x:Name="TimelineScroll" Grid.Row="0" Background="#4B4D50" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="False"><local:TimelineView x:Name="Timeline" HorizontalAlignment="Left" VerticalAlignment="Top" /></ScrollViewer>
        <GridSplitter x:Name="MixerSplitter" Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" ShowsPreview="False" KeyboardIncrement="10" DragIncrement="1" Focusable="True" ToolTip="Resize the lower mixer; use Up and Down when focused" AutomationProperties.Name="Resize lower mixer" DragDelta="MixerSplitterDragged"><GridSplitter.Style><Style TargetType="GridSplitter"><Setter Property="Background" Value="#191D20" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GridSplitter"><Border Background="{TemplateBinding Background}"><Border Background="#65717A" Width="32" Height="1" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="#325D67" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#414A50" /></Trigger></Style.Triggers></Style></GridSplitter.Style></GridSplitter>
        <Grid x:Name="MixerZone" Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="25" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Border x:Name="MixerHeader" Background="#303337" BorderBrush="#17191B" BorderThickness="0,1,0,1"><DockPanel Margin="6,0"><TextBlock Text="Mixer" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,16,0" /><TextBlock x:Name="MixerCount" Text="0 channels" Foreground="#A0A7AF" VerticalAlignment="Center" FontSize="10" /></DockPanel></Border>
          <ScrollViewer x:Name="MixerScroll" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" VerticalContentAlignment="Bottom" Background="#222527" SizeChanged="MixerViewportChanged"><StackPanel x:Name="Mixer" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="6,3,6,2" /></ScrollViewer>
        </Grid>
      </Grid>
    </Grid>
    <Border Grid.Row="5" Background="#34373A" BorderBrush="#141618" BorderThickness="0,1,0,0"><Grid x:Name="CommandSurface" Margin="6,3">
      <Grid.Resources>
        <Style x:Key="TransportButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Width" Value="29" /><Setter Property="Height" Value="26" /><Setter Property="Margin" Value="1,0" /><Setter Property="Padding" Value="8" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
        <Style x:Key="TransportNumber" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="FontFamily" Value="Consolas" /><Setter Property="Height" Value="24" /><Setter Property="MinHeight" Value="24" /><Setter Property="Margin" Value="1,0" /><Setter Property="Padding" Value="4,1" /><Setter Property="ToolTip" Value="Enter to apply. Escape to restore the current value." /></Style>
        <Style x:Key="TransportCommit" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Width" Value="20" /><Setter Property="Height" Value="24" /><Setter Property="Margin" Value="0" /><Setter Property="Padding" Value="5" /></Style>
      </Grid.Resources>
      <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="104" /></Grid.ColumnDefinitions>
      <TextBlock x:Name="TransportContextName" Text="Project timeline" Foreground="#BEC4CB" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0,10,0" />
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Style="{StaticResource AccentSurfaceButton}" Width="29" Height="26" Margin="1,0" Padding="8" ToolTip="Stop" AutomationProperties.Name="Stop" Click="Stop" Background="#B9BEC4" Foreground="#1D2226"><Path Data="M0,0 L10,0 10,10 0,10 Z" Fill="#1D2226" Stretch="Uniform" IsHitTestVisible="False" /></Button>
        <Button Style="{StaticResource TransportButton}" ToolTip="Pause" AutomationProperties.Name="Pause" Click="Pause"><Path Data="M0,0 L3,0 3,10 0,10 Z M7,0 L10,0 10,10 7,10 Z" Fill="#DCE1E5" Stretch="Uniform" IsHitTestVisible="False" /></Button>
        <Button Style="{StaticResource TransportButton}" Width="34" Background="#358E45" BorderBrush="#3EA052" ToolTip="Play project" AutomationProperties.Name="Play project" Click="Play"><Path Data="M0,0 L10,5 0,10 Z" Fill="White" Stretch="Uniform" IsHitTestVisible="False" /></Button>
      </StackPanel>
      <Border Grid.Column="2" Background="#1C2023" BorderBrush="#101416" BorderThickness="1" Margin="7,1" Padding="8,2"><TextBlock x:Name="Timecode" Text="00:00:00.000" FontFamily="Consolas" FontSize="15" VerticalAlignment="Center" /></Border>
      <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="3,0"><TextBox x:Name="TempoBox" Style="{StaticResource TransportNumber}" Text="120" Width="54" AutomationProperties.Name="Tempo BPM" PreviewKeyDown="NumericFieldKeyDown" /><Button Style="{StaticResource TransportCommit}" Click="SetTempo" ToolTip="Apply tempo" AutomationProperties.Name="Apply tempo"><Path Data="M1,5 L4,8 10,1" Stroke="#CED5DB" StrokeThickness="1.4" Stretch="Uniform" IsHitTestVisible="False" /></Button><Label Content="BPM" FontSize="10" Margin="3,0,4,0" /></StackPanel>
      <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="7,0" VerticalAlignment="Center"><Label Content="Position" FontSize="10" /><TextBox x:Name="PositionBox" Style="{StaticResource TransportNumber}" Text="0" Width="79" AutomationProperties.Name="Playhead seconds" PreviewKeyDown="NumericFieldKeyDown" /><Button Style="{StaticResource TransportCommit}" Click="Seek" ToolTip="Seek to position" AutomationProperties.Name="Seek to position"><Path Data="M1,5 L10,5 M6,1 L10,5 6,9" Stroke="#CED5DB" StrokeThickness="1.4" Stretch="Uniform" IsHitTestVisible="False" /></Button><Label Content="s" FontSize="10" /></StackPanel>
      <StackPanel Grid.Column="5" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="L" Foreground="#A0A8B0" FontSize="9" Width="12" /><ProgressBar Width="82" Height="5" Minimum="0" Maximum="1" Value="{Binding PeakLeft, Mode=OneWay}" AutomationProperties.Name="Left submitted peak" VerticalAlignment="Center" /></StackPanel><StackPanel Orientation="Horizontal" Margin="0,4,0,0"><TextBlock Text="R" Foreground="#A0A8B0" FontSize="9" Width="12" /><ProgressBar Width="82" Height="5" Minimum="0" Maximum="1" Value="{Binding PeakRight, Mode=OneWay}" AutomationProperties.Name="Right submitted peak" VerticalAlignment="Center" /></StackPanel></StackPanel>
    </Grid></Border>
    <Border Grid.Row="6" Background="#242729"><TextBlock Text="{Binding Status}" Foreground="#AAB2BB" FontSize="10" Margin="9,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" /></Border>
  </Grid>
</Window>
