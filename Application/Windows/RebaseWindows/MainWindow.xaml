<Window x:Class="Rebase.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Rebase.Windows"
        Title="{Binding Title}" Icon="/Assets/Rebase.png" Width="1280" Height="850" MinWidth="1100" MinHeight="760"
        Background="#282A2C" Foreground="#E5E8ED" FontFamily="Segoe UI" FontSize="11"
        Closing="ClosingWindow" PreviewKeyDown="KeyPressed">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="25" /><RowDefinition Height="34" /><RowDefinition Height="23" /><RowDefinition Height="44" /><RowDefinition Height="*" /><RowDefinition Height="37" /><RowDefinition Height="21" /></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Background="#232527">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0"><Image Source="/Assets/Rebase.png" Width="14" Height="14" VerticalAlignment="Center" /><TextBlock Text="REBASE" FontWeight="SemiBold" FontSize="10" Margin="6,0,5,0" VerticalAlignment="Center" /></StackPanel>
      <Menu x:Name="MainMenu" Background="Transparent" Foreground="#D2D5D8" VerticalAlignment="Center">
        <MenuItem Header="_File"><MenuItem Header="Open example" Click="OpenExample" /><MenuItem Header="Open project…" Click="OpenProject" /><Separator /><MenuItem Header="Save" Click="SaveProject" InputGestureText="Ctrl+S" /><MenuItem Header="Save as…" Click="SaveProjectAs" /><MenuItem Header="Export mixdown…" Click="ExportWav" /></MenuItem>
        <MenuItem Header="_Edit"><MenuItem Header="Undo" Click="Undo" InputGestureText="Ctrl+Z" /><MenuItem Header="Redo" Click="Redo" InputGestureText="Ctrl+Y" /><Separator /><MenuItem Header="Split selected clip at playhead" Click="SplitClip" /><MenuItem Header="Delete selected clip" Click="DeleteClip" /></MenuItem>
        <MenuItem Header="_Transport"><MenuItem Header="Play project" Click="Play" /><MenuItem Header="Pause" Click="Pause" /><MenuItem Header="Stop" Click="Stop" /></MenuItem>
      </Menu>
    </DockPanel>
    <Border Grid.Row="1" Background="#343638" BorderBrush="#181A1C" BorderThickness="0,0,0,1"><Grid x:Name="ProjectActions" Margin="5,2"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal"><Button x:Name="ExampleButton" Content="Open example" Click="OpenExample" /><Button Content="Open…" Click="OpenProject" /><Button Content="Save" Click="SaveProject" /><Button x:Name="UndoButton" Content="↶" ToolTip="Undo" AutomationProperties.Name="Undo" Click="Undo" IsEnabled="False" Width="26" Padding="3" /><Button x:Name="RedoButton" Content="↷" ToolTip="Redo" AutomationProperties.Name="Redo" Click="Redo" IsEnabled="False" Width="26" Padding="3" /></StackPanel>
      <Border Grid.Column="1" Background="#1C1E20" Margin="0,2" />
      <StackPanel x:Name="ArrangementActions" Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0"><TextBlock Text="Drag / trim" Foreground="#CED1D4" VerticalAlignment="Center" Margin="0,0,12,0" /><Button Content="Split" Click="SplitClip" /><Button Content="Delete" Click="DeleteClip" /><Border Width="1" Background="#1C1E20" Margin="10,2" /><Label Content="Snap" /><ComboBox x:Name="SnapBox" Width="90" SelectedIndex="0" SelectionChanged="SnapChanged" AutomationProperties.Name="Snap grid"><ComboBoxItem Content="Off" Tag="off" /><ComboBoxItem Content="Quarter" Tag="quarter" /><ComboBoxItem Content="Eighth" Tag="eighth" /><ComboBoxItem Content="Sixteenth" Tag="sixteenth" /><ComboBoxItem Content="Bar" Tag="bar" /></ComboBox><Label Content="Zoom" Margin="8,0,0,0" /><Slider x:Name="Zoom" Width="78" Minimum="15" Maximum="140" Value="32" ValueChanged="ZoomChanged" VerticalAlignment="Center" AutomationProperties.Name="Timeline zoom" /></StackPanel>
      <Button Grid.Column="3" Content="Export mixdown…" Click="ExportWav" />
    </Grid></Border>
    <Border Grid.Row="2" Background="#2A2C2E" BorderBrush="#181A1C" BorderThickness="0,0,0,1"><DockPanel Margin="7,0"><TextBlock x:Name="ProjectInfo" DockPanel.Dock="Right" Foreground="#B1B5BA" VerticalAlignment="Center" FontSize="10" /><TextBlock Text="Project" Foreground="#90959B" VerticalAlignment="Center" Margin="0,0,8,0" /><TextBlock x:Name="ProjectName" Text="Untitled" Foreground="#D7DADD" VerticalAlignment="Center" /></DockPanel></Border>
    <Border Grid.Row="3" Background="#222426" BorderBrush="#17191B" BorderThickness="0,0,0,1"><StackPanel x:Name="ClipInspector" Orientation="Horizontal" Margin="8,2">
      <StackPanel Width="190"><TextBlock Text="Selected event" Foreground="#91979E" FontSize="9" /><TextBlock x:Name="SelectionName" Text="None" TextTrimming="CharacterEllipsis" Margin="1,5,0,0" /></StackPanel>
      <StackPanel Width="170"><TextBlock Text="Start (seconds)" Foreground="#91979E" FontSize="9" /><DockPanel><Button x:Name="MoveButton" Content="Set" Click="MoveClip" DockPanel.Dock="Right" Padding="6,2" MinHeight="20" /><TextBox x:Name="MoveBox" Text="0" AutomationProperties.Name="Selected clip start seconds" FontFamily="Consolas" MinHeight="20" Padding="4,2" /></DockPanel></StackPanel>
      <StackPanel Width="170" Margin="5,0,0,0"><TextBlock Text="End (seconds)" Foreground="#91979E" FontSize="9" /><DockPanel><Button Content="Trim" Click="TrimClip" DockPanel.Dock="Right" Padding="6,2" MinHeight="20" /><TextBox x:Name="TrimBox" Text="0" AutomationProperties.Name="Selected clip end seconds" FontFamily="Consolas" MinHeight="20" Padding="4,2" /></DockPanel></StackPanel>
      <StackPanel Margin="15,0"><TextBlock Text="Source offset" Foreground="#91979E" FontSize="9" /><TextBlock x:Name="SourceOffsetText" Text="0.000 s" FontFamily="Consolas" Margin="1,5,0,0" /></StackPanel>
    </StackPanel></Border>
    <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="206" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border x:Name="EditSurface" Background="#292C2E" BorderBrush="#17191B" BorderThickness="0,0,2,0"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
        <Border Background="#202224" BorderBrush="#151719" BorderThickness="0,0,0,1" Padding="8,5"><TextBlock Text="Inspector" FontWeight="SemiBold" /></Border>
        <Border Background="#454A4E" Margin="5,6,5,3" Padding="5,4"><TextBlock x:Name="InspectorTrack" Text="No track selected" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /></Border>
        <TextBlock x:Name="InspectorTrackInfo" Text="Open a project to begin" Foreground="#AAB0B7" Margin="10,5,8,10" TextWrapping="Wrap" FontSize="10" />
        <Grid Margin="10,0,8,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions><TextBlock Text="Level" Foreground="#949BA3" /><TextBlock x:Name="InspectorGain" Grid.Column="1" Text="—" FontFamily="Consolas" /><TextBlock Grid.Row="1" Text="Pan" Foreground="#949BA3" Margin="0,9,0,0" /><TextBlock x:Name="InspectorPan" Grid.Row="1" Grid.Column="1" Text="—" FontFamily="Consolas" Margin="0,9,0,0" /></Grid>
        <Border Background="#3C4044" Margin="5,1" Padding="5,4"><TextBlock Text="Event editing" FontWeight="SemiBold" FontSize="10" /></Border>
        <Button Content="Split at playhead" Click="SplitClip" Margin="8,6,8,2" /><Button Content="Delete selected clip" Click="DeleteClip" Margin="8,2,8,8" />
        <StackPanel x:Name="SourcePanel" Visibility="Collapsed" Margin="5,5,5,8"><Border Background="#3C4044" Padding="5,4"><TextBlock Text="Retained source events" FontWeight="SemiBold" FontSize="10" /></Border><ComboBox x:Name="SourceEventsBox" DisplayMemberPath="DisplayName" SelectionChanged="SourceSelectionChanged" AutomationProperties.Name="Retained source event" Margin="2,7,2,3" /><TextBlock x:Name="SourceMediaInfo" Foreground="#B4BBC3" TextWrapping="Wrap" FontSize="10" Margin="4,4,4,6" /><Button x:Name="AttachSourceButton" Content="Attach PCM…" Click="AttachSourcePCM" /><Button Content="Audition source" Click="AuditionSource" /><Button x:Name="ExportSourceButton" Content="Export source…" Click="ExportSource" /><TextBlock Text="Isolated source audition. Project timing, mixer and effects are not applied." Foreground="#949BA3" TextWrapping="Wrap" FontSize="10" Margin="4,7,4,0" /></StackPanel>
        <TextBlock Text="Space  Play / pause&#x0a;Ctrl+S  Save project" Foreground="#7F8790" FontFamily="Consolas" FontSize="10" Margin="10,18,8,0" />
      </StackPanel></ScrollViewer></Border>
      <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="*" MinHeight="220" /><RowDefinition Height="25" /><RowDefinition Height="221" /></Grid.RowDefinitions>
        <ScrollViewer x:Name="TimelineScroll" Grid.Row="0" Background="#4B4D50" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" SizeChanged="TimelineViewportChanged"><local:TimelineView x:Name="Timeline" /></ScrollViewer>
        <Border Grid.Row="1" Background="#303337" BorderBrush="#17191B" BorderThickness="0,1,0,1"><DockPanel Margin="6,0"><TextBlock Text="Mixer" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,16,0" /><TextBlock x:Name="MixerCount" Text="0 channels" Foreground="#A0A7AF" VerticalAlignment="Center" FontSize="10" /></DockPanel></Border>
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Background="#222527"><StackPanel x:Name="Mixer" Orientation="Horizontal" Margin="6,3,6,2" /></ScrollViewer>
      </Grid>
    </Grid>
    <Border Grid.Row="5" Background="#34373A" BorderBrush="#141618" BorderThickness="0,1,0,0"><Grid x:Name="CommandSurface" Margin="6,3"><Grid.ColumnDefinitions><ColumnDefinition Width="205" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="116" /></Grid.ColumnDefinitions>
      <TextBlock x:Name="TransportContextName" Text="Project timeline" Foreground="#BEC4CB" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0,10,0" />
      <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="■" Width="35" ToolTip="Stop" AutomationProperties.Name="Stop" Click="Stop" Background="#B9BEC4" Foreground="#1D2226" /><Button Content="Ⅱ" Width="35" ToolTip="Pause" AutomationProperties.Name="Pause" Click="Pause" /><Button Content="▶" Width="44" Background="#358E45" BorderBrush="#3EA052" Foreground="White" ToolTip="Play project" AutomationProperties.Name="Play project" Click="Play" /></StackPanel>
      <Border Grid.Column="2" Background="#1C2023" BorderBrush="#101416" BorderThickness="1" Margin="8,1" Padding="9,2"><TextBlock x:Name="Timecode" Text="00:00:00.000" FontFamily="Consolas" FontSize="17" VerticalAlignment="Center" /></Border>
      <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="3,0"><Label Content="Tempo" /><TextBox x:Name="TempoBox" Text="120" Width="52" AutomationProperties.Name="Tempo BPM" FontFamily="Consolas" /><Button Content="Set BPM" Click="SetTempo" /></StackPanel>
      <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="9,0" VerticalAlignment="Center"><Label Content="Position" /><TextBox x:Name="PositionBox" Text="0" Width="75" AutomationProperties.Name="Playhead seconds" FontFamily="Consolas" /><Button Content="Seek" Click="Seek" /></StackPanel>
      <StackPanel Grid.Column="5" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="L" Foreground="#A0A8B0" FontSize="9" Width="12" /><ProgressBar Width="94" Height="5" Minimum="0" Maximum="1" Value="{Binding PeakLeft, Mode=OneWay}" AutomationProperties.Name="Left submitted peak" VerticalAlignment="Center" /></StackPanel><StackPanel Orientation="Horizontal" Margin="0,4,0,0"><TextBlock Text="R" Foreground="#A0A8B0" FontSize="9" Width="12" /><ProgressBar Width="94" Height="5" Minimum="0" Maximum="1" Value="{Binding PeakRight, Mode=OneWay}" AutomationProperties.Name="Right submitted peak" VerticalAlignment="Center" /></StackPanel></StackPanel>
    </Grid></Border>
    <Border Grid.Row="6" Background="#242729"><TextBlock Text="{Binding Status}" Foreground="#AAB2BB" FontSize="10" Margin="9,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" /></Border>
  </Grid>
</Window>
